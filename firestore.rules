rules_version = '2';

// Reglas de Firestore para SPORTV:
//  - LEER: cualquier persona puede ver los eventos (lo usa la web pública).
//  - ESCRIBIR: solo usuarios autenticados (los del panel admin).
service cloud.firestore {
  match /databases/{database}/documents {
    match /eventos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}